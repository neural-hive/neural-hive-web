# ─────────────────────────────────────────────────────────────
# NEURAL HIVE — environment configuration
#
# Copy this file to .env (or .env.production / .env.local) and
# fill in real values. Nothing in this file is read anywhere
# except through src/config/index.js, so this is the single
# source of truth for the whole app.
#
# IMPORTANT: VITE_PRESALE_ACTIVE is a master kill switch, but it
# is NOT the only safety check. src/composables/usePresale.js
# also refuses to submit a deposit if VITE_TOKEN_CONTRACT_ADDRESS
# or VITE_PAYMENT_ADDRESS is still a placeholder/zero address.
# Both checks have to pass before the "Deposit" button will do
# anything. See README.md before going live.
# ─────────────────────────────────────────────────────────────

# Master switch. "true" turns the live presale UI + deposit flow on.
# "false" (default) shows the "not live yet" state everywhere.
VITE_PRESALE_ACTIVE=false

# --- Token identity -------------------------------------------------
VITE_TOKEN_SYMBOL=HIVE
VITE_TOKEN_NAME="Neural Hive"

# Replace with the deployed ERC-20 (or equivalent) token contract.
# Leave as-is and the app will refuse to run a live presale.
VITE_TOKEN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Replace with the deployed presale/escrow contract that exposes a
# `deposit` method. This is the address the wallet actually sends to
# and the address usePresale.js calls .deposit() on.
VITE_PRESALE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Fallback plain payment address, only used if your presale design
# takes raw transfers instead of a contract call. Leave as placeholder
# if you are using PRESALE_CONTRACT_ADDRESS + deposit().
VITE_PAYMENT_ADDRESS=0x0000000000000000000000000000000000000000

# --- Presale economics ------------------------------------------------
VITE_TOKEN_PRICE_USD=0.0005
VITE_PRESALE_SUPPLY=6000000000
VITE_TARGET_RAISE_USD=3000000
VITE_MIN_CONTRIBUTION_USD=5
VITE_TOTAL_SUPPLY=100000000000

# ISO 8601 datetimes. Used for the countdown and for the "did the
# 12-month window close" refund-eligibility check in the UI.
VITE_PRESALE_START=2026-01-01T00:00:00Z
VITE_PRESALE_END=2026-12-31T23:59:59Z

# --- Network ------------------------------------------------------
# Chain ID the presale contract is deployed on, e.g. 1 (Ethereum),
# 137 (Polygon), 8453 (Base), 56 (BNB Chain).
VITE_CHAIN_ID=1
VITE_CHAIN_NAME="Ethereum Mainnet"
VITE_RPC_URL=https://your-rpc-provider.example/REPLACE_ME
VITE_BLOCK_EXPLORER_URL=https://etherscan.io

# Accepted stablecoin for contributions (the token users pay WITH,
# not HIVE itself). Needs its own contract address + decimals so the
# UI can format amounts and request the right ERC-20 approval.
VITE_PAYMENT_TOKEN_SYMBOL=USDT
VITE_PAYMENT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
VITE_PAYMENT_TOKEN_DECIMALS=6

# WalletConnect v2 project ID — required for the WalletConnect option
# in the wallet picker. Get one at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=REPLACE_WITH_WALLETCONNECT_PROJECT_ID

# --- Links used in the "Verify Everything" transparency section ---
VITE_DOCS_URL=https://docs.example.com/REPLACE_ME
VITE_AUDIT_REPORT_URL=
VITE_GITHUB_URL=https://github.com/REPLACE_ME
VITE_DISCORD_URL=https://discord.gg/REPLACE_ME
VITE_X_URL=https://x.com/REPLACE_ME


# --- Typography ---------------------------------------------------
# Leave these untouched to keep the current typography.
# Try a different size without touching CSS: 16, 17, 18, 19, etc.
VITE_FONT_SIZE=17
# Optional override. Example: Cambria, Georgia, serif
# VITE_FONT_FAMILY="Cambria, Georgia, serif"
